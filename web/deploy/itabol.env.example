# /etc/itabol/itabol.env — read by the systemd unit (EnvironmentFile).
# Only ITABOL_REGISTRY and ITABOL_GEODATA_ROOT are required.

ITABOL_REGISTRY=/etc/itabol/layers.toml
ITABOL_GEODATA_ROOT=/srv/itabol/geodata

# Listen on loopback only; nginx terminates HTTPS and forwards requests.
ITABOL_HOST=127.0.0.1
ITABOL_PORT=8000
ITABOL_ALLOWED_HOSTS=bold.example.org

# Per-session upload directories (must not be inside the geodata directory).
ITABOL_WORK_DIR=/var/lib/itabol/work
ITABOL_RETENTION_MINUTES=60
ITABOL_CLEANUP_SECONDS=60

# Limits sized for 2 vCPU / 4 GB RAM: one job at a time, a short queue.
ITABOL_MAX_UPLOAD_MB=5
ITABOL_MAX_UNCOMPRESSED_MB=50
# At most 100 specimens per workbook (project rule).
ITABOL_MAX_RECORDS=100
ITABOL_MAX_JOBS=1
ITABOL_MAX_QUEUED=8
ITABOL_MAX_SESSIONS=50
ITABOL_PREVIEW_ROWS=2000

# Taxonomy completion from the BOLD API (outbound HTTPS to portal.boldsystems.org).
ITABOL_BOLD_TAXONOMY=true
ITABOL_BOLD_MIN_INTERVAL=1.0
ITABOL_BOLD_TIMEOUT=20
ITABOL_BOLD_MAX_LOOKUPS=100

ITABOL_LOG_LEVEL=info

# GDAL block cache in MB (GDAL's default is 5% of RAM); keep it modest.
GDAL_CACHEMAX=128

# Review page: compliance rules (default: the package's config/compliance.toml),
# basemap layer (default: automatic) and size limit.
#ITABOL_COMPLIANCE=/etc/itabol/compliance.toml
#ITABOL_BASEMAP_LAYER=region
ITABOL_REVIEW_MAX_RECORDS=100

# Start-up warm-up (about 20 s, before the port is announced) and memory release
# after each job; keep both on for a small VPS.
ITABOL_WARMUP=true
# Slow uploads: the body must arrive within 60 s; idle connections closed after 15 min.
ITABOL_BODY_TIMEOUT=60
# Open service: limits per client address. Behind nginx on the same host the
# address comes from X-Forwarded-For.
ITABOL_TRUST_FORWARDED=true
ITABOL_RATE_UPLOADS=20
ITABOL_RATE_ENRICHMENTS=20
ITABOL_MAX_INFLIGHT_PER_CLIENT=2
ITABOL_MAX_SESSIONS_PER_CLIENT=5
ITABOL_BOLD_MAX_PER_HOUR=600
ITABOL_IDLE_TIMEOUT=900
ITABOL_RELEASE_MEMORY=true
