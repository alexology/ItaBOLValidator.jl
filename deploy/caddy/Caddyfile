# Caddy in front of ItaBOLWeb: HTTPS (automatic certificates), upload size
# limit and an access log in which the last part of every IP address is
# removed. Replace itabol.example.org with your domain (also in
# docker-compose.yml). On a server that already runs ASVAtlas, add only the
# block below to the ASVAtlas Caddyfile (see deploy/README.md).

itabol.example.org {
	encode gzip

	# Workbooks: at most 5 MB (ITABOL_MAX_UPLOAD_MB); a little margin here.
	request_body {
		max_size 6MB
	}

	# Caddy sets no time limit on the backend's response by default: an
	# enrichment with many new taxon names (about one per second) can last minutes.
	reverse_proxy itabol:8000

	log {
		output file /var/log/caddy/itabol-access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 24 48
				request>client_ip ip_mask 24 48
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}
